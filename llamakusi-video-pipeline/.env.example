GEMINI_API_KEY=
# Modèles / voix (valeurs par défaut = ce que la doc Google liste au 29/09/2026)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=
GEMINI_ASR_MODEL=gemini-3.5-transcribe
# Supabase — mêmes noms que l'app Next. Si D:\...\TEF_IRN_V3\.env.local existe, il est lu
# automatiquement : inutile de recopier ici. Sinon renseigner :
NEXT_PUBLIC_SUPABASE_URL=https://jksrmyyfllitrkarvgvk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Mixage — musique de fond : déposer assets/music/bed.mp3 (ou .wav…), ou pointer un fichier :
# MUSIC_FILE=assets/music/track02-background.mp3
# MUSIC_GAIN_DB=-14
# Fonds par défaut : rotation parmi assets/backgrounds/short-loop-*.mp4 / long-loop-*.mp4.
# Décommenter pour forcer UN fichier sur tout le format :
# BG_SHORT=short-loop-01.mp4
# BG_LONG=long-loop-01.mp4
# BG_VIDEO_DIM=0.70
